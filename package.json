{
  "name": "@alevettih/typed-route-template",
  "description": "A tiny, type-safe helper for building and reusing parameterised URL/route templates in TypeScript. It keeps your runtime API simple while leveraging modern template literal types to prevent mismatched parameters at compile time.",
  "version": "0.0.1",
  "homepage": "https://github.com/Alevettih/typed-route-template",
  "author": {
    "name": "Alexandr Tikhonenko",
    "email": "alevettih@ya.ru"
  },
  "scripts": {
    "build:dev": "tsc --project src/tsconfig.lib.json",
    "build:prod": "tsc --project src/tsconfig.lib.prod.json",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,html,scss,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,css,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "husky": "^9.1.0",
    "jest": "^30.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "ts-jest": "29.4.5",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,css}": [
      "prettier --write"
    ]
  },
  "license": "MIT",
  "keywords": [
    "typescript",
    "routing",
    "urls"
  ],
  "repository": {
    "type": "github",
    "url": "https://github.com/Alevettih/typed-route-template"
  },
  "bugs": {
    "url": "https://github.com/Alevettih/typed-route-template/issues"
  },
  "module": "dist/public-api.js",
  "typings": "dist/public-api.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    }
  }
}
